<?xml version="1.0" encoding="utf-8"?>
<!-- Cortinilla de presentación: logo, resplandor y nombre de Cenit. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/intro_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cenit_intro"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/intro_logo"
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:contentDescription="Cenit"
            android:src="@drawable/cenit_logo" />

        <com.izzy2lost.psx2.NeonGradientTextView
            android:id="@+id/intro_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.42"
            android:paddingStart="12dp"
            android:text="CENIT"
            android:textColor="@android:color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/intro_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.72"
            android:letterSpacing="0.16"
            android:text="PlayStation 2 Emulator"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

        <View
            android:id="@+id/intro_line"
            android:layout_width="72dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#66FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/intro_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:alpha="0.4"
        android:letterSpacing="0.12"
        android:text="Toca para continuar"
        android:textColor="@android:color/white"
        android:textSize="11sp" />
</FrameLayout>
