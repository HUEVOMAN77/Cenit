<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de inicio de Cenit, rediseño 0.6.9:
  cabecera con degradado neón (logo + Cenit / PS2 EMULATOR + buscar + 3 puntos),
  carrusel "SIGUIENDO DONDE LO DEJASTE", sección "TU BIBLIOTECA" con contador,
  grilla de tarjetas con carátula + nombre, y barra inferior con filete neón.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:orientation="vertical">

    <!-- ============ HEADER ============ -->
    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="6dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/home_logo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Cenit"
            android:src="@drawable/cenit_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.izzy2lost.psx2.NeonGradientTextView
                android:id="@+id/home_wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Cenit"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.22"
                android:text="PS2 EMULATOR"
                android:textColor="#9AA3AD"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_home_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Buscar juegos"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/search_24px"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btn_home_overflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Más opciones"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/more_vert_24px"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Aviso fino de configuración pendiente (solo si falta algo) -->
    <LinearLayout
        android:id="@+id/home_status_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#10151B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/home_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Comprobando configuración…"
            android:textColor="#C7D0DA"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_home_setup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:text="Configurar"
            android:textColor="@color/cenit_neon_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Fila de búsqueda (aparece al tocar la lupa) -->
    <LinearLayout
        android:id="@+id/home_search_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B0E13"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/home_search_input"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/cenit_search_field"
            android:drawableStart="@drawable/search_24px"
            android:drawablePadding="10dp"
            android:drawableTint="#6B7683"
            android:hint="Buscar juego…"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@android:color/white"
            android:textColorHint="#6B7683"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ============ CONTENIDO ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===== Recientes (se oculta si no hay historial) ===== -->
                <include
                    android:id="@+id/home_section_recent"
                    layout="@layout/include_home_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_recent_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone" />

                <!-- ===== Biblioteca ===== -->
                <include
                    android:id="@+id/home_section_library"
                    layout="@layout/include_home_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <LinearLayout
                    android:id="@+id/home_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="72dp"
                    android:paddingBottom="40dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:alpha="0.35"
                        android:contentDescription="@null"
                        android:src="@drawable/stadia_controller_24px"
                        app:tint="#9AA3AD" />

                    <TextView
                        android:id="@+id/home_empty_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="Todavía no hay juegos. Añade una carpeta con tus copias de PS2 (ISO, CHD o CSO)."
                        android:textColor="#8A949F"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_home_empty_action"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Añadir carpeta de juegos"
                        android:textColor="@color/cenit_neon_blue" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </FrameLayout>

    <!-- ============ BARRA INFERIOR ============ -->
    <LinearLayout
        android:id="@+id/home_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6050810"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/bg_home_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tab_home"
                style="@style/Cenit.BottomTab"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/tab_home_icon"
                    style="@style/Cenit.BottomTabIcon"
                    android:src="@drawable/home_24px" />

                <TextView
                    android:id="@+id/tab_home_label"
                    style="@style/Cenit.BottomTabLabel"
                    android:text="Inicio" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_library"
                style="@style/Cenit.BottomTab"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/tab_library_icon"
                    style="@style/Cenit.BottomTabIcon"
                    android:src="@drawable/apps_24px" />

                <TextView
                    android:id="@+id/tab_library_label"
                    style="@style/Cenit.BottomTabLabel"
                    android:text="Biblioteca" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_folders"
                style="@style/Cenit.BottomTab"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/tab_folders_icon"
                    style="@style/Cenit.BottomTabIcon"
                    android:src="@drawable/folder_24px" />

                <TextView
                    android:id="@+id/tab_folders_label"
                    style="@style/Cenit.BottomTabLabel"
                    android:text="Carpetas" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_settings"
                style="@style/Cenit.BottomTab"
                android:layout_width="0dp"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/tab_settings_icon"
                    style="@style/Cenit.BottomTabIcon"
                    android:src="@drawable/settings_24px" />

                <TextView
                    android:id="@+id/tab_settings_label"
                    style="@style/Cenit.BottomTabLabel"
                    android:text="Ajustes" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
