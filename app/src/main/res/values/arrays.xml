    <!-- La posición n corresponde a EECycleRate = n - 3 (ver FullscreenUI_Settings).
         Es control de VELOCIDAD, no de rendimiento: por debajo de 100% el juego va
         más lento pero clavado; por encima corre de más y el audio se rompe. -->
    <string-array name="ee_cycle_entries">
        <item>50% (lento y clavado)</item>
        <item>60% (lento y clavado)</item>
        <item>75% (casi jugable, sin tirones)</item>
        <item>100% (Normal)</item>
        <item>130% (rápido, el audio se desfasa)</item>
        <item>180% (velocidad de viñeta)</item>
        <item>300% (solo para saltar escenas)</item>
    </string-array>

    <!-- Cuotas de EE por juego (EECycleSkip): el EE emulado corre a menos ciclos
         por cuadro real. Es underclock: solo ayuda en el pequeño subset de juegos
         que NUNCA llegan a tiempo con el EE al 100% (Shadow of the Colossus).
         PCSX2 mismo avisa que casi siempre es perjudicial: de ahí que sea
         opt-in y por-juego, no default. -->
    <string-array name="cycle_skip_entries">
        <item>Normal</item>
        <item>Suave</item>
        <item>Moderado</item>
        <item>Máximo</item>
    </string-array>

    <!-- Cola de cuadros (VsyncQueueSize), Cenit 0.6.6. La posición ES el valor
         de la clave: 0 = ritmo óptimo (menos input lag, más exigente), 1..n =
         n cuadros por delante. -->
    <string-array name="frame_queue_entries">
        <item>Óptima (respuesta rápida)</item>
        <item>1 cuadro</item>
        <item>2 cuadros</item>
        <item>3 cuadros</item>
        <item>4 cuadros</item>
    </string-array>

    <!-- Precarga de texturas (TexturePreloading): 0 Off, 1 Partial, 2 Full. -->
    <string-array name="preload_entries">
        <item>Apagada</item>
        <item>Parcial</item>
        <item>Completa</item>
    </string-array>
