<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- M3 outlined button (if used anywhere) -->
    <style name="PSX2.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/brand_ripple</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- M3 elevated button with semi-transparent surface container background and uppercase text -->
    <style name="PSX2.ElevatedTransparentButton" parent="Widget.Material3.Button.ElevatedButton">
        <item name="rippleColor">@color/brand_ripple</item>
        <item name="backgroundTint">@color/brand_surface_container_semi</item>
        <item name="android:textAllCaps">true</item>

        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Custom toggle button with light pink selected background -->
    <style name="PSX2.ToggleButton" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="backgroundTint">@drawable/toggle_button_background</item>
        <item name="rippleColor">@color/brand_ripple</item>
    </style>

    <!-- ======================================================================
         Mandos en pantalla — "cristal blanco" (0.6.42)
         ======================================================================
         Todos los botones son círculos de aro blanco fino, sin relleno, con el
         color puesto SOLO en el glifo (△ verde, □ violeta, ○ rojo, ✕ azul). Es
         lo que se ve en la referencia del usuario: el mando es un contorno, no
         una pieza opaca encima del juego.

         El rosa queda para L2/R2: son gatillos analógicos y en la referencia
         son los únicos anillos que no son blancos.

         OJO con una trampa de MaterialButton: primero resuelve
         shapeAppearanceOverlay y DESPUES aplica cornerRadius si viene setado.
         Por eso acá se usa cornerRadius grande (100dp = círculo para cualquier
         tamaño <=200dp) y no una forma compartida. -->

    <!-- Base común de todo botón del overlay. -->
    <style name="PSX2.OverlayButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="backgroundTint">@color/overlay_fill_sel</item>
        <item name="rippleColor">@color/overlay_ripple</item>
        <item name="android:textColor">@color/overlay_text_sel</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Botón circular: hombros, cruceta, faciales y los clics de stick. -->
    <style name="PSX2.OverlayCircle" parent="PSX2.OverlayButton">
        <item name="strokeColor">@color/overlay_ring_sel</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
    </style>

    <!-- Gatillo (L2/R2): mismo círculo, anillo rosa. -->
    <style name="PSX2.OverlayCircle.Trigger" parent="PSX2.OverlayCircle">
        <item name="strokeColor">@color/overlay_ring_trigger_sel</item>
    </style>

    <!-- Pétalo de la cruceta. En 0.6.34 era un cuadrado con las puntas
         cortadas; en la referencia son círculos sueltos como el resto. -->
    <style name="PSX2.OverlayCircle.Petal" parent="PSX2.OverlayCircle" />

    <!-- Etiqueta suelta (SELECT / START): pastilla con el mismo aro, letra
         espaciada y sin relleno. -->
    <style name="PSX2.OverlayPill" parent="PSX2.OverlayButton">
        <item name="strokeColor">@color/overlay_ring_sel</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>
</resources>
