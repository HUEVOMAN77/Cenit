<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==========================================================================
         Mandos en pantalla — "cristal blanco" (0.6.42)
         ==========================================================================
         Reemplaza la paleta neón cian/magenta de 0.6.34. La referencia del
         usuario son aros blancos finos y translúcidos con los glifos de color;
         el color deja de estar en el anillo y queda solo en el glifo. Dos
         reglas que se sostienen en estos valores:

         1) El RELLENO es prácticamente nada (0 % en reposo). Lo que se ve es el
            contorno, no la pastilla: el mando está encima del juego.
         2) El CONTORNO en reposo anda por el 60 % y al presionar sube a ~95 %.
            Es el único canal por el que el usuario sabe que tocó.

         El rosa queda reservado a los gatillos (L2/R2): en la referencia son
         los únicos anillos que no son blancos, y así se leen como analógicos
         (media presión) y no como botones. -->

    <!-- Contornos. Blanco neutro para todo, rosa para los gatillos. -->
    <color name="overlay_ring">#99FFFFFF</color>
    <color name="overlay_ring_pressed">#F2FFFFFF</color>
    <color name="overlay_ring_trigger">#99FFA6D9</color>
    <color name="overlay_ring_trigger_pressed">#F0FFC2E6</color>

    <!-- Relleno: nada en reposo, apenas un velo al presionar. -->
    <color name="overlay_fill">#00000000</color>
    <color name="overlay_fill_pressed">#1AFFFFFF</color>

    <!-- Texto de los botones (L1/L2/SELECT/…): mismo presupuesto que el anillo
         en reposo para que el mando no se pinte dos veces. -->
    <color name="overlay_text">#B8FFFFFF</color>
    <color name="overlay_text_pressed">#FFFFFFFF</color>
    <color name="overlay_ripple">#33FFFFFF</color>

    <!-- ==========================================================================
         Paleta del stick analógico (JoystickView lo pinta a mano en Canvas)
         ==========================================================================
         En la referencia el stick es un aro blanco fino con una perla
         translúcida dentro. Sin relleno oscuro: el juego se ve a través. -->
    <color name="overlay_stick_ring">#99FFFFFF</color>
    <color name="overlay_stick_ring_active">#F2FFFFFF</color>
    <color name="overlay_stick_base">#14000000</color>
    <color name="overlay_stick_knob_hi">#4DFFFFFF</color>
    <color name="overlay_stick_knob_lo">#26FFFFFF</color>
</resources>
