<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tarjeta de sección del panel de ajustes -->
    <style name="Cenit.Settings.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/cenit_settings_card</item>
        <item name="strokeColor">@color/cenit_settings_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>

    <!-- Título de sección -->
    <style name="Cenit.Settings.Section" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cenit_neon_blue</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Etiqueta de campo -->
    <style name="Cenit.Settings.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/cenit_settings_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Texto de ayuda -->
    <style name="Cenit.Settings.Caption" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/cenit_settings_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Separador fino -->
    <style name="Cenit.Settings.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@color/cenit_settings_divider</item>
    </style>

    <!-- Fila de acción tipo lista -->
    <style name="Cenit.Settings.ActionRow" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textColor">@color/cenit_settings_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">14dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/cenit_neon_blue</item>
        <item name="rippleColor">#22A7FF</item>
    </style>

    <!-- Botón de grupo (renderer / orientación) -->
    <style name="Cenit.Settings.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/cenit_toggle_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:checkable">true</item>
        <item name="backgroundTint">@color/cenit_toggle_bg</item>
        <item name="strokeColor">@color/cenit_toggle_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33A7FF</item>
    </style>

    <!-- Interruptor -->
    <style name="Cenit.Settings.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/cenit_settings_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">2dp</item>
    </style>

    <!-- Campo desplegable (Spinner) -->
    <style name="Cenit.Settings.Spinner" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/cenit_field_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Chip de categoría de la pantalla de ajustes -->
    <style name="Cenit.Settings.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/cenit_chip_bg</item>
        <item name="android:textColor">@color/cenit_chip_text</item>
        <item name="chipStrokeColor">@color/cenit_chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- ============ Filas del panel de ajustes del inicio ============ -->
    <style name="Cenit.SettingsRow" parent="">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/cenit_row_bg</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="Cenit.SettingsRowIcon" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="tint">@color/cenit_neon_blue</item>
    </style>

    <style name="Cenit.SettingsRowText" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="Cenit.SettingsRowTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/cenit_settings_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Cenit.SettingsRowSub" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/cenit_settings_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ============ Barra de pestañas inferior ============ -->
    <style name="Cenit.BottomTab" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Cenit.BottomTabIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="tint">@color/home_tab_tint</item>
    </style>

    <style name="Cenit.BottomTabLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">@color/home_tab_tint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
