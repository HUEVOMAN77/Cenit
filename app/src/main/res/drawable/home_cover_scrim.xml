<?xml version="1.0" encoding="utf-8"?>
<!-- Velo inferior de la tarjeta: transparente arriba, negro ~72% abajo,
     para que el titulo sobrepuesto se lea sobre cualquier caratula. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#0D000000"
        android:endColor="#B8000000"
        android:startColor="#00000000"
        android:type="linear" />
</shape>
