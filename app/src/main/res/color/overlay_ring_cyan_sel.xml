<?xml version="1.0" encoding="utf-8"?>
<!-- Anillo neón cyan de los mandos en pantalla: reposo tenue (deja pasar el juego),
     presionado casi opaco (es lo único que avisa de que el toque entró). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:color="@color/overlay_ring_cyan_pressed" />
    <item android:state_checked="true" android:color="@color/overlay_ring_cyan_pressed" />
    <item android:color="@color/overlay_ring_cyan" />
</selector>
